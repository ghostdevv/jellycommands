{
	"name": "jellycommands",
	"version": "1.0.0-next.45",
	"author": "Willow (GHOST) <ghostdevbusiness@gmail.com> (https://ghostdev.xyz)",
	"license": "MIT",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"require": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./ambient": {
			"types": "./ambient.d.ts"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"CHANGELOG.md",
		"ambient.d.ts"
	],
	"scripts": {
		"dev": "tsup-node --watch src",
		"build": "tsup-node",
		"package": "pnpm build && publint",
		"test": "vitest --coverage",
		"lint": "publint"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "^2.1.9",
		"discord.js": "^14.15.3",
		"publint": "catalog:",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"vitest": "^2.1.9"
	},
	"peerDependencies": {
		"discord.js": "^14.15.3"
	},
	"dependencies": {
		"discord-api-types": "^0.37.83",
		"ofetch": "^1.3.4",
		"zod": "^3.23.8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ghostdevv/jellycommands.git"
	},
	"keywords": [],
	"bugs": {
		"url": "https://github.com/ghostdevv/jellycommands/issues"
	},
	"homepage": "https://github.com/ghostdevv/jellycommands",
	"volta": {
		"node": "20.13.1",
		"pnpm": "10.18.3"
	},
	"engines": {
		"node": ">=20.13.1"
	}
}
